  "messages": {
    "welcome": {
      "en": "Hi! I am the Hubfares Help assistant (scripted demo). Choose a language to continue.",
      "hi": "नमस्ते! मैं Hubfares सहायता सहायक हूँ (स्क्रिप्टेड डेमो)। आगे बढ़ने के लिए भाषा चुनें।",
      "hinglish": "Hi! Main Hubfares Help assistant hoon (scripted demo). Aage badhne ke liye language choose karein."
    },
    "mainMenu": {
      "en": "How can we help you today?",
      "hi": "आज हम आपकी कैसे मदद करें?",
      "hinglish": "Aaj hum aapki kaise help karein?"
    },
    "askPnr": {
      "en": "Please enter the PNR of your booking.",
      "hi": "कृपया अपनी बुकिंग का PNR दर्ज करें।",
      "hinglish": "Please apni booking ka PNR enter karein."
    },
    "askCase": {
      "en": "Please enter your case or refund reference.",
      "hi": "कृपया अपना केस या रिफंड संदर्भ दर्ज करें।",
      "hinglish": "Please apna case ya refund reference enter karein."
    },
    "notFound": {
      "en": "No matching booking found for your agency. Verify the reference or contact Hubfares Support.",
      "hi": "आपकी एजेंसी के लिए कोई मेल खाती बुकिंग नहीं मिली। संदर्भ जांचें या Hubfares सपोर्ट से संपर्क करें।",
      "hinglish": "Aapki agency ke liye koi matching booking nahi mili. Reference check karein ya Hubfares Support se contact karein."
    },
    "confirmNotice": {
      "en": "This creates a demo support request for Hubfares Operations. It does not cancel, change or refund anything by itself.",
      "hi": "यह Hubfares ऑपरेशंस के लिए एक डेमो सपोर्ट अनुरोध बनाता है। यह स्वयं कुछ भी रद्द, बदल या रिफंड नहीं करता।",
      "hinglish": "Yeh Hubfares Operations ke liye ek demo support request banata hai. Yeh khud kuch cancel, change ya refund nahi karta."
    },
    "caseCreated": {
      "en": "Your request has been logged. Reference:",
      "hi": "आपका अनुरोध दर्ज हो गया है। संदर्भ:",
      "hinglish": "Aapki request log ho gayi hai. Reference:"
    },
    "fallback": {
      "en": "I can only help with the options below.",
      "hi": "मैं केवल नीचे दिए विकल्पों में मदद कर सकता हूँ।",
      "hinglish": "Main sirf neeche diye options mein help kar sakta hoon."
    },
    "callCenter": {
      "en": "Hubfares Call Center (demo): +91 20 0000 0000, 24×7. Live transfer is a planned integration.",
      "hi": "Hubfares कॉल सेंटर (डेमो): +91 20 0000 0000, 24×7। लाइव ट्रांसफर नियोजित इंटीग्रेशन है।",
      "hinglish": "Hubfares Call Center (demo): +91 20 0000 0000, 24×7. Live transfer planned integration hai."
    },
    "details": {
      "en": "Add a short description (optional).",
      "hi": "संक्षिप्त विवरण जोड़ें (वैकल्पिक)।",
      "hinglish": "Short description add karein (optional)."
    }
  },
